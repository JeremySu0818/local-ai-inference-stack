[Unit]
Description=Dynamic AI Router
After=network.target

[Service]
Type=simple
User=jeremy
WorkingDirectory=/home/jeremy/ai-router
Environment=AI_ROUTER_CONFIG=/home/jeremy/ai-router/config.yaml
ExecStart=/home/jeremy/ai-router/.venv/bin/uvicorn router.app:app_factory --factory --host 0.0.0.0 --port 9000 --workers 1 --timeout-graceful-shutdown 3700
KillMode=mixed
TimeoutStopSec=3800
Restart=no
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
